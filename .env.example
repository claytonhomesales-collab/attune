# Optional: enable AI tone scoring + rewrite coach via Vercel AI Gateway
# https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=

# Stripe. Prefer a secret or restricted key when you have one.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Filled from `stripe login` when a secret key is not available.
STRIPE_OAK_TOKEN=
STRIPE_OAK_REFRESH_TOKEN=
STRIPE_OAK_EXPIRES_AT=
STRIPE_ACCOUNT_ID=
STRIPE_LIVEMODE=true
