{
  "manifest_version": 3,
  "name": "Attune",
  "version": "0.1.0",
  "description": "Rewrite the message you are typing. Direct, warm, or short. The draft stays on this device.",
  "action": {
    "default_title": "Attune",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://app.slack.com/*",
        "https://messages.google.com/*",
        "https://www.messenger.com/*",
        "https://discord.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
